# Postgres. On Vercel, add Neon from the Marketplace and this is set for you.
# Locally you can use an embedded database with no server: DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=

# Any long random string. Signs dashboard logins. (openssl rand -hex 32)
AUTH_SECRET=

# Dashboard logins: name:password, comma separated.
USERS=ishan:change-me,tanzil:change-me

# One key per agent: name:key, comma separated. Each agent's actions are recorded under its name.
# Generate keys with: openssl rand -hex 24
API_KEYS=chatgpt:REPLACE,claude:REPLACE,instinct:REPLACE

# Vercel sends this to the scheduled jobs. Any random string.
CRON_SECRET=

# Turns on research, scoring, drafting, plain-English logging and the weekly review.
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_SMART_MODEL=gpt-5.5

# Optional: your public URL, used in links shown on the Settings page.
# APP_URL=https://deskshift-gtm.vercel.app
